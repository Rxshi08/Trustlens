PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/trustlens?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Python OCR service base URL (without trailing slash)
PYTHON_OCR_URL=http://127.0.0.1:8000

# Comma-separated allowed frontend origins
FRONTEND_URL=http://localhost:5173

# Optional: secret required to create admin accounts via API
ADMIN_SECRET=your_admin_creation_secret
